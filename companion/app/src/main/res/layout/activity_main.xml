<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/rootColumn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="@dimen/screen_pad"
        android:paddingRight="@dimen/screen_pad"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="2dp">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@drawable/ic_soul"
                android:contentDescription="@string/app_name"
                android:layout_marginEnd="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textSize="28sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/subtitle"
            android:textSize="14sp"
            android:alpha="0.7"
            android:paddingBottom="16dp" />

        <TextView
            android:id="@+id/rootText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/checking"
            android:textSize="14sp"
            android:paddingBottom="12dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/card_glass"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/det_soul"
            app:strokeWidth="1dp">

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/checking"
                android:fontFamily="monospace"
                android:textSize="15sp"
                android:lineSpacingExtra="5dp"
                android:padding="20dp" />
        </com.google.android.material.card.MaterialCardView>

        <TextView android:id="@+id/hdrDesktop" style="@style/DetSectionHeader" android:text="@string/sec_desktop" />

        <Button
            android:id="@+id/enterBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/enter_go" />

        <Button
            android:id="@+id/exitBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            style="?attr/materialButtonOutlinedStyle"
            android:text="@string/exit_go" />

        <Button
            android:id="@+id/recoverBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            style="?attr/materialButtonOutlinedStyle"
            android:text="@string/recover_go" />

        <TextView android:id="@+id/hdrGuest" style="@style/DetSectionHeader" android:text="@string/sec_guest" />

        <Button
            android:id="@+id/restartGuestBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="?attr/materialButtonOutlinedStyle"
            android:text="@string/restart_guest" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp"
            android:baselineAligned="false">

            <Button
                android:id="@+id/rebootBtn"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                style="?attr/materialButtonOutlinedStyle"
                android:text="@string/reboot_go" />

            <Button
                android:id="@+id/powerBtn"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                style="?attr/materialButtonOutlinedStyle"
                android:text="@string/poweroff_go" />
        </LinearLayout>

        <TextView android:id="@+id/hdrDiag" style="@style/DetSectionHeader" android:text="@string/sec_diag" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <Button
                android:id="@+id/logBtn"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                style="?attr/borderlessButtonStyle"
                android:text="@string/view_log" />

            <Button
                android:id="@+id/refreshBtn"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                style="?attr/borderlessButtonStyle"
                android:text="@string/refresh" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
