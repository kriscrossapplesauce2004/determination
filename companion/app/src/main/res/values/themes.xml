<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Material You 3: dynamic colour on Android 12+, graceful fallback below.
         Edge-to-edge with transparent system bars; a soul-tinted gradient
         shows through the translucent surfaces. -->
    <style name="Theme.Determination" parent="Theme.Material3.DynamicColors.DayNight">
        <item name="colorPrimary">@color/det_soul</item>
        <item name="android:windowBackground">@drawable/bg_gradient</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <style name="DetSectionHeader">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>
</resources>
