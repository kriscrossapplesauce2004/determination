# Determination: KWin/Plasma-Mobile session unit (guest /etc/systemd/system/).
# WHY A UNIT: KWin's DRM backend refuses to open ANY device without a logind
# session — NoopSession::openRestricted is literally `return -1` (kwin 6.3,
# src/core/session_noop.cpp), even as root. PAMName=login + TTYPath makes
# pam_systemd register a real logind session for this service (the greetd/
# kiosk trick), and systemd-logind DOES run in the container (verified
# 2026-07-13). Started/stopped by toggle/native-plasma, NOT enabled at boot.
[Unit]
Description=Determination native Plasma session (raw KMS + zink)
After=systemd-logind.service dbus.service
Wants=systemd-logind.service

[Service]
Type=simple
User=root
PAMName=login
TTYPath=/dev/tty1
UtmpIdentifier=tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal
ExecStart=/usr/local/bin/det-plasma-session
