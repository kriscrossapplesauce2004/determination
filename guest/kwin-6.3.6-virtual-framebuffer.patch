+bool VirtualQPainterLayer::exportFrame()
+{
+    const char *path = std::getenv("DETERMINATION_FRAMEBUFFER");
+    QImage *frameImage = image();
+    if (!path || !*path || !frameImage) {
+        return true;
+    }
+
+    if (!m_frameMapping || m_frameSize != frameImage->size()) {
+        if (m_frameMapping) {
+            munmap(m_frameMapping, m_frameMappingSize);
+            m_frameMapping = nullptr;
+        }
+        if (m_frameFd >= 0) {
+            close(m_frameFd);
+            m_frameFd = -1;
+        }
+        const uint64_t bufferSize = uint64_t(frameImage->bytesPerLine()) * frameImage->height();
+        const uint64_t mappingSize = DET_FRAMEBUFFER_HEADER_SIZE + bufferSize * DET_FRAMEBUFFER_COUNT;
+        if (mappingSize > SIZE_MAX) {
+            return false;
+        }
+        m_frameFd = open(path, O_RDWR | O_CREAT | O_TRUNC | O_CLOEXEC, 0600);
+        if (m_frameFd < 0 || ftruncate(m_frameFd, off_t(mappingSize)) != 0) {
+            return false;
+        }
+        m_frameMappingSize = size_t(mappingSize);
+        m_frameMapping = mmap(nullptr, m_frameMappingSize, PROT_READ | PROT_WRITE,
+                              MAP_SHARED, m_frameFd, 0);
+        if (m_frameMapping == MAP_FAILED) {
+            m_frameMapping = nullptr;
+            return false;
+        }
+        std::memset(m_frameMapping, 0, DET_FRAMEBUFFER_HEADER_SIZE);
+        auto header = static_cast<det_framebuffer_header *>(m_frameMapping);
+        header->magic = DET_FRAMEBUFFER_MAGIC;
+        header->version = DET_FRAMEBUFFER_VERSION;
+        header->header_size = DET_FRAMEBUFFER_HEADER_SIZE;
+        header->format = DET_FRAMEBUFFER_XRGB8888;
+        header->width = uint32_t(frameImage->width());
+        header->height = uint32_t(frameImage->height());
+        header->stride = uint32_t(frameImage->bytesPerLine());
+        header->buffer_count = DET_FRAMEBUFFER_COUNT;
+        header->buffer_size = bufferSize;
+        m_frameSize = frameImage->size();
+    }
+
+    auto header = static_cast<det_framebuffer_header *>(m_frameMapping);
+    const uint64_t sequence = __atomic_load_n(&header->sequence, __ATOMIC_RELAXED) + 1;
+    const uint32_t index = uint32_t(sequence % DET_FRAMEBUFFER_COUNT);
+    auto destination = static_cast<uint8_t *>(m_frameMapping) +
+        DET_FRAMEBUFFER_HEADER_SIZE + index * header->buffer_size;
+    std::memcpy(destination, frameImage->constBits(), size_t(header->buffer_size));
+    timespec timestamp = {};
+    clock_gettime(CLOCK_MONOTONIC, &timestamp);
+    header->monotonic_ns = uint64_t(timestamp.tv_sec) * 1000000000ULL + timestamp.tv_nsec;
+    __atomic_store_n(&header->active_index, index, __ATOMIC_RELAXED);
+    __atomic_store_n(&header->sequence, sequence, __ATOMIC_RELEASE);
+    return true;
+}
