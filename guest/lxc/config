# Determination guest container base config (LXC).
# The guest must see: Android /dev (binder, kgsl, ion/dmabuf, dri, input),
# the property area, and /vendor + /system libs — spec §1 implication chain.
# toggle/generate-lxc-config appends only the device nodes present on the host.

lxc.uts.name = determination
lxc.arch = aarch64
lxc.rootfs.path = dir:/data/determination/guest
lxc.init.cmd = /sbin/init

# Android has no /etc/lxc conventions; keep everything under /data/determination.
lxc.log.file = /data/determination/log/lxc.log
lxc.log.level = WARN

# --- Namespaces / privileges ---
# Privileged container by design: it must own real device nodes. Isolation is
# not the threat model here; the container exists for the glibc world, not
# for sandboxing.
lxc.include =
lxc.apparmor.profile = unconfined
lxc.autodev = 1
lxc.autodev.tmpfs.size = 25000000
# Private devpts with a usable ptmx (0666 + /dev/ptmx symlink). Without it
# the inherited devpts has ptmxmode=000 and terminals can't open PTYs —
# foot's "failed to open PTY" killed the first phoc session (2026-07-06).
lxc.pty.max = 1024
# proc/sys/cgroup must be requested explicitly — systemd needs all three.
# (Found on first boot 2026-07-03: without this /proc is absent and systemd
# hangs before its first console line.)
lxc.mount.auto = proc:mixed sys:mixed cgroup:mixed

# --- Android world, read-only, at the REAL root paths ---
# NOT under /android/: the partitions carry absolute symlinks into /apex
# (e.g. /system/bin/linker64 -> /apex/com.android.runtime/bin/linker64) and
# libhybris' compiled default search path is /vendor/lib64:/system/lib64:
# /odm/lib64 with /system/build.prop hardcoded. Debian has none of these at
# root, so there is no collision. (Found 2026-07-04: the /android/ prefix
# broke the bionic linker — the apex symlinks dangled.)
lxc.mount.entry = /system system none bind,ro,create=dir,optional 0 0
lxc.mount.entry = /vendor vendor none bind,ro,create=dir,optional 0 0
lxc.mount.entry = /odm odm none bind,ro,create=dir,optional 0 0
lxc.mount.entry = /apex apex none rbind,ro,create=dir,optional 0 0
# Property area — libhybris mmaps this at the fixed path /dev/__properties__.
# create=dir: autodev's tmpfs is fresh, the target must be made or the bind
# silently no-ops (it's optional).
lxc.mount.entry = /dev/__properties__ dev/__properties__ none bind,ro,create=dir,optional 0 0

# --- Device nodes are generated at install/start time ---
# Binder layout, GPU family, allocator API, input, DRM and audio nodes vary by
# Android generation and vendor. generate-lxc-config probes them and preserves
# host SELinux labels with bind mounts. A private binderfs instance is added
# when the running kernel supports it; host binder contexts are then mounted at
# the canonical guest names required for Android HAL traffic.

# --- Guest -> host control channel (spec §4 convenience) ---
# The guest cannot run root actions on the Android side (leave desktop mode,
# power off). It drops command files here; det-hostagent (root) watches the
# host side and acts. /mnt is a plain rootfs dir systemd never remounts, so
# the bind is stable (unlike /run, which systemd shadows with a tmpfs).
lxc.mount.entry = /data/determination/run/control mnt/det-control none bind,create=dir 0 0

# Generated config also binds the companion app's device-protected files dir
# at /mnt/determination-presenter when the app is installed. /run is avoided
# because systemd's guest tmpfs would hide an LXC mount placed beneath it.

lxc.cgroup.devices.allow = a *:* rwm

# --- Network: veth into Android's connectivity, NAT'd by toggle/guest-start ---
lxc.net.0.type = veth
lxc.net.0.link = determ0
lxc.net.0.flags = up
lxc.net.0.ipv4.address = 192.168.117.2/24
lxc.net.0.ipv4.gateway = 192.168.117.1
