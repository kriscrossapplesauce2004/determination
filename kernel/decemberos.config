# DecemberOS kernel config fragment — container enables for the LXC glibc guest.
# Applied on top of the stock guacamoleb defconfig by kernel/build.sh via
# scripts/kconfig/merge_config.sh. This is the ONLY place kernel gaps get fixed;
# Magisk cannot add kernel features (design spec §2).
#
# Target tree: crDroid sm8150 fork, 4.14.357-openela (see kernel/fetch.sh).
# Recon 2026-07-01 (artifacts/kernel-config-full.txt): running kernel already
# has NAMESPACES, UTS_NS, NET_NS, MEMCG, VETH, BRIDGE, NAT/MASQUERADE, ASHMEM,
# OVERLAY_FS, FUSE_FS, SECCOMP_FILTER and — notably — ANDROID_BINDERFS.
# Missing (the reason this fragment exists): PID_NS, USER_NS, IPC_NS,
# CGROUP_DEVICE, CGROUP_PIDS, POSIX_MQUEUE.

# --- Namespaces (LXC hard requirements) ---
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
# USER_NS is what Android kernels most often lack. Unprivileged containers are
# not a goal (the guest is launched by root from the Magisk module), but LXC
# wants it available and it's cheap.
CONFIG_USER_NS=y

# --- cgroups (v2 delegation for the guest) ---
CONFIG_CGROUPS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CPUSETS=y
CONFIG_MEMCG=y
CONFIG_MEMCG_SWAP=y
CONFIG_CGROUP_SCHED=y
CONFIG_BLK_CGROUP=y

# --- Binder exposure to the guest ---
# Recon: this tree already has the binderfs backport (CONFIG_ANDROID_BINDERFS=y,
# /dev/binderfs live with binder-control). The guest gets its own binder
# contexts by mounting a fresh binderfs instance in its IPC namespace — which
# is why IPC_NS above is required. No extra binder devices needed.
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y

# --- Memory / buffer sharing (libhybris + Wayland) ---
CONFIG_ASHMEM=y
CONFIG_MEMFD_CREATE=y
CONFIG_SYNC_FILE=y

# --- Guest filesystem plumbing ---
CONFIG_OVERLAY_FS=y
CONFIG_FUSE_FS=y
CONFIG_SQUASHFS=y
CONFIG_POSIX_MQUEUE=y
# Multiple devpts instances: option was removed (always-on) after 4.7, but some
# downstream trees still carry it — merge_config will warn if absent, harmless.
CONFIG_DEVPTS_MULTIPLE_INSTANCES=y

# --- Guest networking (veth + NAT off the phone's connection) ---
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y

# --- Vendor drivers built-in (learned on flash day, 2026-07-02) ---
# Stock ships these =m in /vendor/lib/modules, vermagic-locked to the stock
# kernel — WiFi died the moment our kernel booted. Building them =y removes
# the module-pairing problem for good: no kmods overlay to reship, WiFi works
# on any DecemberOS kernel. (Stock init's insmod of the vendor .ko then fails
# harmlessly — driver is already in the kernel.)
CONFIG_QCA_CLD_WLAN=y
CONFIG_USB_GSPCA=y

# --- Misc container hygiene ---
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_KEYS=y

# --- Kernel #3 additions (2026-07-02) ------------------------------------

# Virtual terminal support. Android kernels ship VT off; enabling it gives
# /dev/tty0../dev/ttyN and the VT ioctl surface — useful for the guest
# (agetty/login on a real tty, openvt-style tools, anything that expects
# /dev/console semantics) and for debugging. With no console driver bound
# it costs nothing at runtime: the panel stays SurfaceFlinger's.
# CONFIG_FRAMEBUFFER_CONSOLE is deliberately NOT set — fbcon binding to the
# DRM/MSM fbdev emulation would fight the §4 panel handoff for the display.
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_VT_HW_CONSOLE_BINDING=y

# CRIU-shaped process introspection (also enables lxc-checkpoint someday);
# cheap, pure-upstream, off in the stock config for no articulated reason.
CONFIG_CHECKPOINT_RESTORE=y

# Run foreign-format binaries in the guest (qemu-user for cross-arch debs,
# properly registered Wine/whatever). Debian expects it to exist.
CONFIG_BINFMT_MISC=y

# nftables — Debian's default firewall backend. Without this, iptables in
# the guest only works via iptables-legacy; with it, stock iptables-nft,
# nft(8), and anything using the nftables API (docker-in-guest, firewalld)
# just work. NFT_COMPAT carries the xtables matches iptables-nft leans on.
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_CT=y
CONFIG_NFT_COUNTER=y
CONFIG_NFT_LOG=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_MASQ_IPV4=y
CONFIG_NFT_MASQ_IPV6=y
CONFIG_NFT_CHAIN_NAT_IPV4=y
CONFIG_NFT_CHAIN_NAT_IPV6=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_COMPAT=y

# IPv6 NAT for the guest veth (the v4 equivalents are in the networking
# block above; carrier networks are increasingly v6-only).
CONFIG_NF_NAT_IPV6=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y

# More guest-networking shapes: macvlan (guest as a peer on the phone's
# network instead of NAT'd behind it) and 802.1Q tagging.
CONFIG_MACVLAN=y
CONFIG_VLAN_8021Q=y
