#!/system/bin/sh
# Generate guest-side configuration derived safely from the host display.

set -u
DET=${DET:-/data/determination}
. "$DET/bin/device-config"

GUEST_ETC="$DET/guest/etc"
[ -d "$DET/guest" ] || { echo "FATAL: guest rootfs missing: $DET/guest" >&2; exit 1; }
mkdir -p "$GUEST_ETC"

PHOC_TMP="$GUEST_ETC/phoc.ini.new"
{
    echo '# Generated by Determination; edit /data/determination/etc/device.conf instead.'
    [ -n "$DET_PANEL_WIDTH" ] && echo "# Physical panel: ${DET_PANEL_WIDTH}x${DET_PANEL_HEIGHT}"
    echo "[output:$DET_HWC_OUTPUT]"
    echo "scale = $DET_OUTPUT_SCALE"
} > "$PHOC_TMP"
mv -f "$PHOC_TMP" "$GUEST_ETC/phoc.ini"
chmod 0644 "$GUEST_ETC/phoc.ini"

DEVICE_TMP="$GUEST_ETC/determination-device.conf.new"
{
    echo '# Generated by Determination; consumed by guest-side helpers.'
    echo "DET_BATTERY_GAUGE=$DET_BATTERY_GAUGE"
    echo "DET_INPUT_QUIRK=$DET_INPUT_QUIRK"
} > "$DEVICE_TMP"
mv -f "$DEVICE_TMP" "$GUEST_ETC/determination-device.conf"
chmod 0644 "$GUEST_ETC/determination-device.conf"

echo "Generated guest display config: output=$DET_HWC_OUTPUT scale=$DET_OUTPUT_SCALE panel=${DET_PANEL_WIDTH:-unknown}x${DET_PANEL_HEIGHT:-unknown}"
