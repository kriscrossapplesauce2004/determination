#!/system/bin/sh
# Determination handoff, desktop -> phone (spec §4). Reverse order of desktop-on:
# guest releases composer first, then SF restarts, then input is released.
# Installed to /data/determination/bin/. Run as root.

set -u
DET=${DET:-/data/determination}
. "$DET/bin/lifecycle-lib"
emergency=0
case "${1:-}" in
    "") ;;
    --emergency) emergency=1 ;;
    *) echo "usage: desktop-off [--emergency]" >&2; exit 2 ;;
esac
exec >>"$DET/log/toggle.log" 2>&1
echo "--- desktop-off $(date)"
lc_lock_acquire || exit 1
generation=$(sed -n 's/^generation=//p' "$DET/run/transition.state" 2>/dev/null | tail -n 1)
[ -n "$generation" ] || generation=0
signal_generation=$generation
[ "$emergency" -eq 0 ] || signal_generation=
lc_state_write EXITING "$generation" preflight running
finish() { lc_lock_release; }
trap finish EXIT HUP INT TERM

# 1. Kill the suppressor before restarting SF, or it'll fight us.
rm -f "$DET/run/desktop-mode"
lc_pid_signal suppressor TERM "$signal_generation"

# 1b. Kill the frozen system_server so init/zygote respawns it fresh. Its
#     display thread is still blocked in the BLAST txn to the stopped SF ---
#     SIGCONT would just make Watchdog register the accumulated block time
#     and self-kill anyway. SIGKILL cuts straight to a clean respawn.
lc_pid_signal ss-freezer TERM "$signal_generation"
sspid=$(pidof system_server 2>/dev/null)
[ -n "$sspid" ] && kill -KILL "$sspid" 2>/dev/null

# 2. Guest compositor must release the composer client *cleanly* --- killing it
#    mid-frame is how the HAL state machine wedges (spec risk register).
#    Clients first (phosh session, then any bare foot), then phoc (SIGTERM:
#    wlroots runs its display destroy). phoc's death also closes the evdev
#    fds, which releases the guest's EVIOCGRABs (§4) --- Android input is
#    live from that moment even though SF is still coming back.
"$DET/lxc/bin/lxc-attach" -P "$DET" -n guest -- /bin/sh -c \
    'pkill -TERM phosh; pkill -TERM squeekboard; pkill -TERM foot; true' 2>/dev/null
# Guest pids are visible from the host pid ns (host root, init ns), so poll
# for the clients actually exiting instead of a fixed sleep --- typically
# ~0.3s, capped at 1.5s (previously a flat 1s that raced slow teardowns).
i=0
while pgrep -x phosh >/dev/null 2>&1 || pgrep -x foot >/dev/null 2>&1; do
    i=$((i+1)); [ $i -gt 15 ] && { echo "WARN: clients still up after 1.5s --- proceeding"; break; }
    sleep 0.1
done
"$DET/lxc/bin/lxc-attach" -P "$DET" -n guest -- /usr/bin/pkill -TERM phoc 2>/dev/null
lc_pid_signal compositor TERM "$signal_generation"
lc_pid_signal client TERM "$signal_generation"
# Same for phoc: it must be GONE (composer client released) before SF binds,
# but waiting a flat 2s was the single biggest chunk of exit latency. Poll to
# 3s max; then a short beat for the composer HAL to drop the client state.
i=0
while pgrep -x phoc >/dev/null 2>&1; do
    i=$((i+1)); [ $i -gt 30 ] && {
        echo "RECOVERY: phoc still owns resources after TERM; refusing SF start"
        "$DET/lxc/bin/lxc-attach" -P "$DET" -n guest -- /usr/bin/pkill -KILL phoc 2>/dev/null
        sleep 0.5
        pgrep -x phoc >/dev/null 2>&1 && { lc_state_write RECOVERY "$generation" compositor ambiguous; exit 1; }
        break
    }
    sleep 0.1
done
sleep 0.5

# 2b. Direct audio is a separate ownership transaction. Withdraw the guest
# claim, wait for PipeWire to release every ALSA fd, then restore only the
# Android owners recorded in the journal. Display recovery continues if audio
# restore fails, but doctor will keep reporting the failed audio phase.
if [ -x "$DET/bin/det-audio-owner" ] && \
   [ -f "$DET/etc/audio-owner.conf" ] && \
   [ -f "$DET/run/audio-owner.state" ]; then
    audio_phase=$(sed -n 's/^phase=//p' "$DET/run/audio-owner.state" | tail -n 1)
    case "$audio_phase" in
        claimed|restoring|restore-failed)
            "$DET/bin/det-audio-owner" restore --apply ||
                echo "WARN: direct audio restore failed; run detctl doctor"
            ;;
    esac
fi

# 3. Restart SF; verify panel re-init (no dead/black transition).
start surfaceflinger
i=0
until [ "$(getprop init.svc.surfaceflinger)" = "running" ]; do
    i=$((i+1)); [ $i -gt 20 ] && echo "WARN: SF slow to return" && break
    sleep 0.5
done

# 3b. A restarted SF replays the boot animation and waits for a "boot
# finished" signal that never comes on an already-booted system --- the
# animation loops over a healthy UI forever (melissa hit this 2026-07-03).
# Tell it to exit ourselves; only when boot is genuinely complete, so a
# real first boot is never cut short. SF sets service.bootanim.exit=0 as
# it starts, so wait until bootanim is actually up before signalling.
if [ "$(getprop sys.boot_completed)" = "1" ]; then
    i=0
    while [ $i -lt 20 ]; do
        [ "$(getprop init.svc.bootanim)" = "running" ] && break
        i=$((i+1)); sleep 0.5
    done
    if [ "$(getprop init.svc.bootanim)" = "running" ]; then
        setprop service.bootanim.exit 1
        setprop service.bootanim.progress 1
        i=0
        while [ "$(getprop init.svc.bootanim)" = "running" ] && [ $i -lt 10 ]; do
            i=$((i+1)); sleep 0.5
        done
        # Belt and braces: if it ignored the property, stop it outright.
        [ "$(getprop init.svc.bootanim)" = "running" ] && stop bootanim && echo "bootanim would not exit --- stopped it"
        echo "boot animation cleared"
    fi
fi

# 4. Release the input grab last, once Android UI is back to receive events.
#    Usually a no-op since §4: desktop-on already killed evgrab at the
#    guest handoff (the guest's own grabs died with phoc in step 2).
lc_pid_signal evgrab TERM "$signal_generation"
rm -f "$DET/run/evgrab.legacy.pid"
lc_state_write PHONE "$generation" complete committed
echo "phone mode restored"

# 5. Battery saver (companion app setting): with the flag set, an idle guest
#    doesn't linger in phone mode --- stop it. desktop-on's guest-start brings
#    it back on the next entry.
if [ -f "$DET/etc/stop-guest-on-exit" ]; then
    echo "stop-guest-on-exit set --- stopping guest"
    "$DET/lxc/bin/lxc-stop" -P "$DET" -n guest -t 10 2>/dev/null
fi
