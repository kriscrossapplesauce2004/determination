#!/system/bin/sh
# Start the guest container headless (no display acquisition). Runs at boot
# from service.sh; desktop-on then only performs the display/input handoff.
# Installed to /data/determination/bin/.

set -u
DET=/data/determination
LXC="$DET/lxc/bin"  # static lxc build pushed alongside the rootfs
export PATH="$LXC:$PATH"
. "$DET/bin/device-config"

# lxc-start pins the container rootfs here; must pre-exist or start fails.
# run/control is the bind source for the guest->host channel (lxc config binds
# it to guest /mnt/det-control); it must exist before lxc-start.
mkdir -p "$DET/lxc/lib/lxc/rootfs" "$DET/run" "$DET/run/control" "$DET/log"

# Generate device binds from the running phone. This runs before every start,
# so an OTA that changes binder or allocator layout cannot leave a stale config.
"$DET/bin/generate-lxc-config" || { echo "FATAL: LXC config generation failed"; exit 1; }
"$DET/bin/generate-guest-config" || { echo "FATAL: guest config generation failed"; exit 1; }

# 2026-07-11: lxc/bin rebuilt with --with-runtime-path=/data/determination/run
# (guest/build-lxc.sh) — the /data/decemberos compat symlink is gone. Deploy
# this script and the new binaries TOGETHER: old binaries + no symlink =
# "Failed to create lock for guest". Clean up a leftover symlink (never a
# real directory).
[ -L /data/decemberos ] && rm -f /data/decemberos
# lxc-info/lxc-attach resolve container "guest" as $lxcpath/guest/config —
# keep a copy of the config at that path (the rootfs dir doubles as it).
# Always refresh so config updates propagate.
cp -f "$DET/lxc/config" "$DET/guest/config"

# /data is mounted nodev: device nodes inside the rootfs would be dead.
# Bind-remount just the guest subtree with dev,exec,suid.
if ! grep -q " $DET/guest " /proc/mounts; then
    mount --bind "$DET/guest" "$DET/guest"
    mount -o remount,bind,dev,exec,suid "$DET/guest" "$DET/guest"
fi

# --- Network: veth bridge + NAT out through whatever's up (wlan0/rmnet) ---
# All of this is asserted by net_assert(), run once now and then re-asserted
# every 20s by a keeper loop: qcom netmgrd/netd periodically REBUILD the
# iptables rule set and the ip-rule chain, silently flushing every foreign
# entry (found 2026-07-07: guest lost even gateway ping; our INPUT accepts
# and pref-9000/21000 rules were gone, nm_mdmprxy chains freshly on top).
# One-shot setup therefore CANNOT keep the guest online.
net_assert() {
    ip link add determ0 type bridge 2>/dev/null
    ip addr add 192.168.117.1/24 dev determ0 2>/dev/null
    ip link set determ0 up
    echo 1 > /proc/sys/net/ipv4/ip_forward

    iptables -t nat -C POSTROUTING -s 192.168.117.0/24 -j MASQUERADE 2>/dev/null ||
        iptables -t nat -A POSTROUTING -s 192.168.117.0/24 -j MASQUERADE
    # Android's netd chains (oem_in/bw/fw/tetherctrl) precede everything;
    # explicit accepts for the guest segment at the very top.
    iptables -C INPUT -i determ0 -j ACCEPT 2>/dev/null ||
        iptables -I INPUT 1 -i determ0 -j ACCEPT
    iptables -C OUTPUT -o determ0 -j ACCEPT 2>/dev/null ||
        iptables -I OUTPUT 1 -o determ0 -j ACCEPT
    iptables -C FORWARD -s 192.168.117.0/24 -j ACCEPT 2>/dev/null ||
        iptables -I FORWARD 1 -s 192.168.117.0/24 -j ACCEPT
    iptables -C FORWARD -d 192.168.117.0/24 -j ACCEPT 2>/dev/null ||
        iptables -I FORWARD 1 -d 192.168.117.0/24 -j ACCEPT

    # Android's policy routing has NO "lookup main" rule — the rule chain
    # ends in "from all unreachable", so replies to the guest die unless
    # the guest subnet is reachable from a consulted table (2026-07-04).
    # Mirror netd's own tether pattern ("iif r_rmnet_data0 lookup wlan0").
    ip rule list | grep -q "to 192.168.117.0/24 lookup main" ||
        ip rule add pref 9000 to 192.168.117.0/24 lookup main
    # Only valid once the wlan0 table exists (WiFi up) — harmless to retry.
    # NB `ip rule list` prints the table NUMBER (1030), not "wlan0", so match
    # on the pref+iif instead (the old "lookup wlan0" grep never matched and
    # we leaned on EEXIST — fine, but this also tolerates a renumbered table).
    [ -n "$DET_WIFI_IFACE" ] && {
        ip rule list | grep -q "^21000:.*iif determ0" ||
            ip rule add pref 21000 iif determ0 lookup "$DET_WIFI_IFACE" 2>/dev/null
    }

    # Fallback egress table: during desktop-mode framework thrash netd can
    # DELETE the wlan0 table outright (2026-07-07) — the pref-21000 rule then
    # matches nothing and guest egress dies even though wlan0 itself is fine.
    # Mirror the live default route into our own table 117 whenever the real
    # path is known; rule lookups fall through empty tables, so pref 21100
    # only carries traffic once netd's table is gone.
    GW=$(ip route get 1.1.1.1 2>/dev/null | sed -n "s/.* via \([0-9.]*\) dev $DET_WIFI_IFACE .*/\1/p")
    [ -n "$GW" ] && ip route replace default via "$GW" dev "$DET_WIFI_IFACE" table 117 2>/dev/null
    ip rule list | grep -q "^21100:.*iif determ0" ||
        ip rule add pref 21100 iif determ0 lookup 117 2>/dev/null
}
net_assert

# net-keeper: re-assert forever (all checks are cheap no-ops while the rules
# survive); 10s ticks in desktop mode (where netd actively fights us), 20s in
# phone mode. Killed by nothing — it must outlive desktop toggles; a reboot
# clears it with everything else.
# WiFi watchdog (desktop mode ONLY — in phone mode wlan0 down may be
# melissa's choice): system_server crash-loops on the stopped SF and its
# restarts bounce WiFi until wlan0 stays DOWN (2026-07-07). If wlan0 sits
# non-up for 3 consecutive ticks, poke `svc wifi enable` (idempotent, framework
# call — timeout'd because system_server may be mid-crash), and keep retrying
# every ~9 ticks while it stays dead. Real fix is the milestone-6 Zygisk hook.
if ! kill -0 "$(cat "$DET/run/net-keeper.pid" 2>/dev/null)" 2>/dev/null; then
    (
        fails=0
        while :; do
            net_assert 2>/dev/null
            if [ -f "$DET/run/desktop-mode" ]; then
                if [ -z "$DET_WIFI_IFACE" ] || [ "$(cat "/sys/class/net/$DET_WIFI_IFACE/operstate" 2>/dev/null)" = "up" ]; then
                    fails=0
                else
                    fails=$((fails+1))
                    if [ "$fails" -eq 3 ] || [ $((fails % 9)) -eq 0 ]; then
                        echo "$DET_WIFI_IFACE not up x$fails — svc wifi enable ($(date))" >> "$DET/log/net-keeper.log"
                        timeout 15 svc wifi enable </dev/null >/dev/null 2>&1
                    fi
                fi
                sleep 10
            else
                fails=0
                sleep 20
            fi
        done
    ) &
    echo $! > "$DET/run/net-keeper.pid"
fi

# Rotate the append-forever lxc log once it passes ~256K (keep the newest half).
[ "$(stat -c %s "$DET/log/lxc.log" 2>/dev/null || echo 0)" -gt 262144 ] &&
    tail -c 131072 "$DET/log/lxc.log" > "$DET/log/lxc.log.tmp" &&
    mv "$DET/log/lxc.log.tmp" "$DET/log/lxc.log"

if ! lxc-info -P "$DET" -n guest 2>/dev/null | grep -q RUNNING; then
    lxc-start -P "$DET" -n guest -f "$DET/lxc/config" -l WARN -o "$DET/log/lxc.log"
    i=0
    until lxc-info -P "$DET" -n guest 2>/dev/null | grep -q RUNNING; do
        i=$((i+1)); [ $i -gt 20 ] && exit 1; sleep 0.5
    done
fi

# Post-start in-guest fixups, ONE lxc-attach (each attach is a full
# fork+setns round trip — three of them was pure startup latency):
# - suid root: Android's /data is mounted nosuid,nodev, and the container
#   rootfs is a bind of a /data subtree, so the container's own `/` inherits
#   nosuid — sudo's setuid bit is then ignored ("effective uid is not 0 ...
#   nosuid", found 2026-07-12). The host-side bind-remount above sets suid on
#   $DET/guest, but that does NOT reach the container root LXC pivots into on
#   4.14, so clear it here on `/` itself. `remount,bind` is required to change
#   a bind mount's per-mount flags (a plain remount targets the superblock).
#   This is what makes password-gated sudo for melissa actually elevate.
# - ashmem: modern libcutils opens /dev/ashmem<boot_id> — a per-boot name the
#   static lxc config can't carry. Without it composer FMQ creation fails and
#   every hwc2 validate returns NO_RESOURCES (found 2026-07-05). Plain misc
#   chardev, so mknod is fine (the binderfs ENXIO rule doesn't apply).
# - devpts: the inherited mount has ptmxmode=000 and no /dev/ptmx, so
#   terminals die with "failed to open PTY" (killed foot 2026-07-06).
#   lxc.pty.max in the config is NOT honored by our static LXC 4.0.12 build.
# - VT nodes: kernel #3 has CONFIG_VT, so seatd binds seat0 to VTs and needs
#   /dev/tty0 for its activation handshake — without it every libseat client
#   times out "waiting session to become active" and phoc can't add the
#   libinput backend (found 2026-07-06, first phosh run). Nothing else uses
#   VTs on this device (no fbcon), so the ioctls are harmless.
BOOTID=$(cat /proc/sys/kernel/random/boot_id)
lxc-attach -P "$DET" -n guest -- /bin/sh -c \
    "mount -o remount,bind,suid,dev,exec / 2>/dev/null; \
     [ -e /dev/ashmem$BOOTID ] || { mknod /dev/ashmem$BOOTID c 10 59 && chmod 666 /dev/ashmem$BOOTID; }; \
     mount -o remount,gid=5,mode=620,ptmxmode=666 devpts /dev/pts 2>/dev/null; \
     [ -e /dev/ptmx ] || ln -sf pts/ptmx /dev/ptmx; \
     for n in 0 1 2; do [ -e /dev/tty\$n ] || mknod -m 620 /dev/tty\$n c 4 \$n; done" \
    2>/dev/null

# Android leaves ping_group_range at the disabled sentinel "1 0" in a new
# network namespace. The guest's /proc/sys is deliberately read-only, so set
# this through Android's writable procfs after entering ONLY the guest netns.
# This permits unprivileged ICMP datagram sockets without making ping setuid or
# granting CAP_NET_RAW to the whole desktop session.
GUEST_INIT=$(lxc-info -P "$DET" -n guest -pH 2>/dev/null)
if [ -n "$GUEST_INIT" ] && command -v nsenter >/dev/null 2>&1; then
    nsenter -t "$GUEST_INIT" -n -- sh -c \
        "echo '0 2147483647' > /proc/sys/net/ipv4/ping_group_range" ||
        echo "WARN: could not enable unprivileged ping in guest netns"
fi

# Guest -> host control agent: lets phosh (desktop mode) trigger exit-to-phone /
# reboot / poweroff, none of which the guest can do itself. Single-instance
# (own pidfile guard); must outlive desktop toggles like net-keeper.
if [ -x "$DET/bin/det-hostagent" ]; then
    "$DET/bin/det-hostagent" &
fi
