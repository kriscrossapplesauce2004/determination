#!/system/bin/sh
# Shared lifecycle primitives. These functions intentionally use only toybox
# compatible tools so adapters remain usable when the native daemon is absent.

LC_DET=${DET:-/data/determination}
LC_RUN="$LC_DET/run"
LC_BOOT_ID_FILE=/proc/sys/kernel/random/boot_id

lc_boot_id() { cat "$LC_BOOT_ID_FILE" 2>/dev/null || echo unknown; }
lc_pid_start() { awk '{print $22}' "/proc/$1/stat" 2>/dev/null; }

lc_pid_write() { # role pid generation
    lc_role=$1 lc_pid=$2 lc_generation=$3
    lc_start=$(lc_pid_start "$lc_pid") || return 1
    lc_tmp="$LC_RUN/$lc_role.pid.new.$$"
    umask 077
    {
        echo "pid=$lc_pid"
        echo "start=$lc_start"
        echo "boot_id=$(lc_boot_id)"
        echo "role=$lc_role"
        echo "generation=$lc_generation"
    } > "$lc_tmp" || return 1
    mv -f "$lc_tmp" "$LC_RUN/$lc_role.pid"
}

lc_pid_matches() { # role [generation]
    lc_role=$1 lc_expected=${2:-}
    lc_file="$LC_RUN/$lc_role.pid"
    [ -r "$lc_file" ] || return 1
    lc_pid= lc_start= lc_boot= lc_record_role= lc_generation=
    while IFS='=' read -r lc_key lc_value; do
        case "$lc_key" in
            pid) lc_pid=$lc_value ;;
            start) lc_start=$lc_value ;;
            boot_id) lc_boot=$lc_value ;;
            role) lc_record_role=$lc_value ;;
            generation) lc_generation=$lc_value ;;
        esac
    done < "$lc_file"
    [ "$lc_record_role" = "$lc_role" ] && [ -n "$lc_pid" ] &&
        [ "$lc_boot" = "$(lc_boot_id)" ] &&
        [ "$(lc_pid_start "$lc_pid")" = "$lc_start" ] || return 1
    [ -z "$lc_expected" ] || [ "$lc_generation" = "$lc_expected" ] || return 1
    return 0
}

lc_pid_signal() { # role signal [generation]
    lc_role=$1 lc_signal=$2 lc_generation=${3:-}
    if lc_pid_matches "$lc_role" "$lc_generation"; then
        lc_pid=
        while IFS='=' read -r lc_key lc_value; do
            [ "$lc_key" = pid ] && lc_pid=$lc_value
        done < "$LC_RUN/$lc_role.pid"
        kill "-$lc_signal" "$lc_pid" 2>/dev/null
    fi
    rm -f "$LC_RUN/$lc_role.pid"
}

lc_lock_owner_live() {
    lc_owner="$LC_RUN/transition.lock/owner"
    [ -r "$lc_owner" ] || return 1
    lc_owner_pid= lc_owner_start= lc_owner_boot=
    while IFS='=' read -r lc_key lc_value; do
        case "$lc_key" in
            pid) lc_owner_pid=$lc_value ;;
            start) lc_owner_start=$lc_value ;;
            boot_id) lc_owner_boot=$lc_value ;;
        esac
    done < "$lc_owner"
    [ -n "$lc_owner_pid" ] && [ -n "$lc_owner_start" ] &&
        [ "$lc_owner_boot" = "$(lc_boot_id)" ] &&
        [ "$(lc_pid_start "$lc_owner_pid")" = "$lc_owner_start" ]
}

lc_lock_acquire() {
    mkdir -p "$LC_RUN"
    lc_lock="$LC_RUN/transition.lock"
    lc_tries=0
    while ! mkdir "$lc_lock" 2>/dev/null; do
        if [ ! -r "$lc_lock/owner" ]; then
            # The lock owner writes its identity immediately after mkdir.
            # Give that write one scheduling tick before treating the lock as
            # abandoned.
            sleep 0.1
        fi
        if ! lc_lock_owner_live; then
            rm -f "$lc_lock/owner"
            rmdir "$lc_lock" 2>/dev/null || true
            continue
        fi
        lc_tries=$((lc_tries + 1))
        if [ "$lc_tries" -ge 50 ]; then
            echo "lifecycle: transition lock busy" >&2
            return 1
        fi
        sleep 0.1
    done
    umask 077
    printf 'pid=%s\nstart=%s\nboot_id=%s\n' \
        "$$" "$(lc_pid_start $$)" "$(lc_boot_id)" > "$lc_lock/owner"
}

lc_lock_release() {
    rm -f "$LC_RUN/transition.lock/owner"
    rmdir "$LC_RUN/transition.lock" 2>/dev/null || true
}

lc_generation_next() {
    lc_old=$(sed -n 's/^generation=//p' "$LC_RUN/transition.state" 2>/dev/null | tail -n 1)
    case "$lc_old" in ''|*[!0-9]*) lc_old=0 ;; esac
    echo $((lc_old + 1))
}

lc_state_write() { # state generation step result
    lc_state=$1 lc_generation=$2 lc_step=$3 lc_result=$4
    lc_tmp="$LC_RUN/transition.state.new.$$"
    umask 077
    {
        echo "schema=1"
        echo "boot_id=$(lc_boot_id)"
        echo "generation=$lc_generation"
        echo "state=$lc_state"
        echo "step=$lc_step"
        echo "result=$lc_result"
    } > "$lc_tmp" || return 1
    mv -f "$lc_tmp" "$LC_RUN/transition.state"
}
