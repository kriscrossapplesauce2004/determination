#!/system/bin/sh
# M5 native-DRM track: KWin/Plasma-Mobile smoke on raw KMS with real GPU
# (zink/Turnip). Run as root, PHONE MODE, device-visible. Reuses the proven
# native-kms-gate prep/restore (SF + composer stop, ss-freezer, backlight
# pre-seed, trap-guarded restore, bootanim keeper).
#
# Stages (pick with $1, default "kwin"):
#   kwin    — kwin_wayland + a terminal, ~2 min hold. The atomic-commit and
#             GL-under-KWin probe. KWin 6 is atomic-only, which modetest
#             never proved — THIS is the real test.
#   plasma  — full Plasma Mobile shell (plasmashell mobile lookandfeel)
#             inside kwin, ~3 min hold.
# Ends by itself; desktop-off-style restore. Logs: /data/local/tmp/
# native-plasma.out + kwin log at guest /var/log/kwin.log (pulled by caller).
set -u
DET=/data/determination
LXC="$DET/lxc/bin/lxc-attach -P $DET -n guest --"
GATE="$DET/run/native-gate"
BL=/sys/class/backlight/backlight/brightness
BL_LEVEL=1400
STAGE="${1:-kwin}"
case "$STAGE" in
    kwin) HOLD=120;;
    plasma) HOLD=180;;
    *) echo "usage: native-plasma [kwin|plasma]"; exit 1;;
esac

[ -f "$DET/run/desktop-mode" ] && { echo "FATAL: desktop mode active — run desktop-off first"; exit 1; }
$LXC /bin/true 2>/dev/null || { echo "FATAL: guest not running"; exit 1; }
$LXC /usr/bin/test -x /usr/bin/kwin_wayland || { echo "FATAL: kwin_wayland missing (plasma install still running?)"; exit 1; }

restored=0
restore() {
    [ "$restored" = 1 ] && return
    restored=1
    echo "== restore =="
    sh "$DET/bin/native-restore"
}
trap restore EXIT INT TERM

# Orphan watchdog: if THIS script dies without its trap (SIGKILL, adb drop,
# tool-call rejection mid-flight — happened 2026-07-13, panel stayed dark),
# the detached watcher runs native-restore. Normal exit removes $GATE first,
# so the watchdog no-ops.
(
    setsid sh -c "
        while kill -0 $$ 2>/dev/null; do sleep 1; done
        [ -f '$GATE' ] && sh '$DET/bin/native-restore' >> /data/local/tmp/native-restore-watchdog.log 2>&1
    " </dev/null >/dev/null 2>&1 &
) &

echo "--- native-plasma stage=$STAGE $(date)"
echo "== 1. input grab =="
"$DET/bin/evgrab" -a -p "$DET/run/evgrab.pid" || { echo "FATAL: evgrab failed"; exit 1; }

echo "== 2. stop SF + suppressor + ss-freezer =="
stop bootanim
stop surfaceflinger
touch "$GATE"
(
    while [ -f "$GATE" ]; do
        [ "$(getprop init.svc.surfaceflinger)" = "running" ] && stop surfaceflinger
        echo "$BL_LEVEL" > "$BL" 2>/dev/null
        sleep 1
    done
) &
(
    while [ -f "$GATE" ]; do
        pid=$(pidof system_server 2>/dev/null)
        if [ -n "$pid" ]; then
            state=$(awk '/^State:/{print $2; exit}' /proc/$pid/status 2>/dev/null)
            [ "$state" != "T" ] && [ "$state" != "t" ] && kill -STOP "$pid" 2>/dev/null
        fi
        sleep 0.2
    done
) &
i=0
while [ "$(getprop init.svc.surfaceflinger)" != "stopped" ]; do
    i=$((i+1)); [ $i -gt 20 ] && { echo "FATAL: SF did not stop"; exit 1; }
    sleep 0.5
done
sleep 1

echo "== 3. stop composer HAL + pre-seed brightness =="
stop vendor.hwcomposer-2-4
i=0
while [ "$(getprop init.svc.vendor.hwcomposer-2-4)" != "stopped" ]; do
    i=$((i+1)); [ $i -gt 10 ] && { echo "FATAL: composer did not stop"; exit 1; }
    sleep 0.5
done
sleep 1
# sde_connector applies props.brightness at first-frame (allow_bl_update):
# seed BEFORE kwin's first commit. 0-1023 scale.
echo 500 > /sys/class/backlight/panel0-backlight/brightness 2>/dev/null
# The SDE writeback connector reports Connected with 34 modes; kwin treats
# it as a real second output and (suspected) maps the touchscreen to it.
# Force it off for the session; native-restore sets it back to detect.
echo off > /sys/class/drm/card0-Virtual-1/status 2>/dev/null
dmesg -c > /dev/null 2>&1

echo "== 4. guest prep (udev db, logind) =="
# logind TakeDevice returns ENODEV for any device without a udev DB entry
# (no udevd in the container). det-input-udevdb fakes the input nodes;
# fake the DRM card the same way (seat0 + master-of-seat tags) or KWin's
# "Failed to open /dev/dri/card0 (No such device)" comes back (2026-07-14).
$LXC /bin/sh -c '
    export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
    [ -x /usr/local/sbin/det-input-udevdb ] && det-input-udevdb 2>/dev/null
    mkdir -p /run/udev/data
    for c in /sys/class/drm/card[0-9]; do
        [ -e "$c/dev" ] || continue
        printf "E:ID_SEAT=seat0\nG:seat\nG:master-of-seat\nQ:seat\nQ:master-of-seat\nI:1\n" \
            > "/run/udev/data/c$(cat "$c/dev")"
    done
    systemctl start systemd-logind
    true'

echo "== 5. launch kwin ($STAGE) via det-plasma.service =="
# KWin 6 refuses to open devices outside a logind session (NoopSession::
# openRestricted is `return -1` — even root). det-plasma.service uses
# PAMName=login + TTYPath so pam_systemd registers a real logind session
# (greetd-style). Session script: guest /usr/local/bin/det-plasma-session
# (mesa /opt/mesa env). KWin 6 DRM backend is atomic-only: this doubles as
# the atomic probe modetest couldn't deliver.
if [ "$STAGE" = plasma ]; then
    $LXC /bin/sh -c 'echo DET_PLASMA_CLIENT=plasmashell > /run/det-plasma.env'
else
    $LXC /bin/sh -c 'echo DET_PLASMA_CLIENT=foot > /run/det-plasma.env'
fi
$LXC /bin/sh -c 'export PATH=/usr/sbin:/usr/bin:/sbin:/bin; systemctl daemon-reload; systemctl restart det-plasma; sleep 2; systemctl is-active det-plasma; loginctl list-sessions --no-legend 2>/dev/null' 2>&1

# Input handoff: once kwin binds its wayland socket, release evgrab so kwin
# (which opened the nodes at startup) starts receiving events.
GPID=$("$DET/lxc/bin/lxc-info" -P "$DET" -n guest -p 2>/dev/null | awk '{print $2}')
i=0
while [ $i -lt 100 ]; do
    [ -n "$GPID" ] && [ -S "/proc/$GPID/root/run/user/0/wayland-0" ] && break
    i=$((i+1)); sleep 0.3
done
if [ -S "/proc/$GPID/root/run/user/0/wayland-0" ]; then
    echo "kwin socket up after ~$((i*3/10))s — releasing input grab"
    [ -f "$DET/run/evgrab.pid" ] && kill "$(cat "$DET/run/evgrab.pid")" 2>/dev/null
    rm -f "$DET/run/evgrab.pid"
else
    echo "WARN: kwin socket never appeared — check /var/log/kwin.log (holding anyway for log capture)"
fi

# TOUCH FIX (2026-07-14): stopping SF suspends the oplus touchpanel into
# gesture mode (taps logged as "detect single tap gesture", no input events).
# The msm_atomic notifier calls are compiled OUT on oplus kernels
# (#ifndef OPLUS_BUG_STABILITY) so kwin's raw-KMS unblank never resumes it.
# oplus_display_private_api.c exposes a manual trigger: writing 1 fires
# MSM_DRM_EVENT_BLANK/UNBLANK → tp_resume. Fire after kwin's first commit.
sleep 3
echo 1 > /sys/kernel/oplus_display/notify_panel_blank 2>/dev/null
echo "touchpanel resume notifier fired"

echo "== 6. holding ${HOLD}s — LOOK AT (and touch) THE PANEL =="
sleep 15
echo "== 6a. input diagnostics (touch dead across runs 1-6) =="
$LXC /bin/sh -c '
    export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
    KPID=$(pgrep -o kwin_wayland); echo "kwin pid: $KPID"
    echo "-- input fds held by kwin:"
    ls -l /proc/$KPID/fd 2>/dev/null | grep -oE "/dev/input/event[0-9]+" | sort | uniq -c
    echo "-- logind session state files:"
    grep -H -E "^(ACTIVE|STATE|VTNR|SEAT|TTY)" /run/systemd/sessions/* 2>/dev/null
    echo "-- active VT: $(cat /sys/class/tty/tty0/active 2>/dev/null)"
    echo "-- kwin event1 (touchpanel) InputDevice properties:"
    BUS=$(cat /run/det-plasma-bus 2>/dev/null)
    [ -n "$BUS" ] && busctl --address="$BUS" call org.kde.KWin \
        /org/kde/KWin/InputDevice/event1 org.freedesktop.DBus.Properties \
        GetAll s org.kde.KWin.InputDevice 2>&1 | tr "}" "\n" | grep -iE "enabled|output|touch|name" | head
    true' 2>&1
sleep $((HOLD-15))

echo "== 7. kwin log tail =="
$LXC /bin/sh -c 'tail -60 /var/log/kwin.log' 2>/dev/null
echo "== 8. kernel log summary =="
dmesg | grep -iE "sde|drm error|dsi|backlight level|fail" | tail -20
restore
exit 0
