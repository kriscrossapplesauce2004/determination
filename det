#!/bin/sh
# det — Determination host helper. Wraps the wireless-adb dance so nothing else
# has to remember it. Uses official platform-tools if present (distro adb has
# broken pairing), and never runs `adb root` (drops wireless transports).
#
#   det find              discover the phone's current wireless port (mdns)
#   det connect           discover + connect
#   det shell [cmd...]    root shell (Magisk su) on the phone
#   det status            connection, root, kernel, mode, guest state
#   det recon             run the §9 recon
#   det push-module       install/refresh the Magisk module zip on the phone
#   det publish           push dist/usb-payload/ to the phone's USB drive
#                         (falls back to /sdcard/Determination if no drive)

set -eu
cd "$(dirname "$0")"

for pt in "$HOME"/platform-tools /tmp/claude-*/-home-melissa/*/scratchpad/platform-tools; do
    [ -x "$pt/adb" ] && PATH="$pt:$PATH" && break
done

mdns_addr() {
    adb mdns services 2>/dev/null | awk '/_adb-tls-connect/ {print $3; exit}'
}

ensure() {
    adb get-state >/dev/null 2>&1 && return 0
    addr=$(mdns_addr)
    [ -n "$addr" ] || { echo "phone not advertising — is Wireless debugging on?" >&2; exit 1; }
    adb connect "$addr" >/dev/null
    adb get-state >/dev/null 2>&1 || { echo "connect to $addr failed (re-pair?)" >&2; exit 1; }
}

case "${1:-status}" in
find)
    addr=$(mdns_addr); [ -n "$addr" ] && echo "$addr" || { echo "not advertising" >&2; exit 1; } ;;
connect)
    ensure && adb devices | sed -n 2p ;;
shell)
    ensure; shift
    if [ $# -gt 0 ]; then adb shell su -c "$*"; else adb shell su; fi ;;
status)
    ensure
    echo "connected: $(adb devices | awk 'NR==2{print $1}')"
    adb shell su <<'EOF'
        echo "root: ok (`id -u`)"
        echo "kernel: `uname -r`"
        [ -e /proc/self/ns/pid ] && echo "pid-ns: YES (Determination kernel)" || echo "pid-ns: no (stock kernel)"
        echo "sf: `getprop init.svc.surfaceflinger`"
        [ -f /data/determination/run/desktop-mode ] && echo "mode: desktop" || echo "mode: phone"
        [ -x /data/determination/bin/desktop-on ] && echo "module: installed" || echo "module: not installed"
EOF
    ;;
recon)
    ensure && ./recon/recon.sh ;;
push-module)
    ensure
    zipf=$(ls magisk-module/determination-magisk-*.zip 2>/dev/null | tail -1)
    [ -n "$zipf" ] || { echo "no zip — run magisk-module/build-module.sh" >&2; exit 1; }
    adb push "$zipf" /data/local/tmp/determination.zip
    adb shell su -c 'magisk --install-module /data/local/tmp/determination.zip && rm /data/local/tmp/determination.zip'
    echo "installed — reboot the phone to activate" ;;
publish)
    ensure
    [ -d dist/usb-payload ] || { echo "no payload — run usb-install/build-usb-payload.sh" >&2; exit 1; }
    # A mounted OTG drive shows up under /mnt/media_rw/<VOLUME>. adb push can't
    # write there (shell uid), so push to /data/local/tmp and su-copy over.
    vol=$(adb shell su -c 'ls /mnt/media_rw/ 2>/dev/null' </dev/null | tr -d '\r' | head -n1)
    adb push dist/usb-payload /data/local/tmp/usb-payload
    if [ -n "$vol" ]; then
        dest="/mnt/media_rw/$vol/Determination"
        adb shell su -c "rm -rf '$dest' && cp -r /data/local/tmp/usb-payload '$dest' && rm -rf /data/local/tmp/usb-payload && sync" </dev/null
        echo "published to USB drive: $dest"
    else
        dest=/sdcard/Determination
        adb shell su -c "rm -rf $dest && cp -r /data/local/tmp/usb-payload $dest && rm -rf /data/local/tmp/usb-payload" </dev/null
        echo "no USB drive mounted — published to $dest instead"
    fi
    echo "next: usb-install/README.md (patch determination-boot.img in Magisk, flash install zip)" ;;
*)
    sed -n '5,11p' "$0"; exit 2 ;;
esac
